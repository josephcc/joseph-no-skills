{
 "version": 1,
 "notes": "Example pattern registry for voice_check.py. The checker loads private/patterns.json when it exists and this file otherwise. Each pattern: id (unique), label, class, optional group, and exactly one of regex (Python re; case-insensitive unless start is true) or matcher (colon_clause or colon_any, the heuristics in the engine); optional fix, start (anchor at sentence start, case-sensitive), statement (skip questions). Classes: ban = any hit fails the hand-back; p0 = fails when significantly above the corpus rate; watch = warns at double the corpus rate, or on one hit when the corpus has none; move = one of the author's own moves, under-use is reported as LOW; info = counted only. Groups: dash, t1 (never-words; also counted in captions), t2 (the author's words that LLMs overuse), t3 (generic LLM phrases), move, habit (default). This example is generic on purpose: every candidate word is a watch row and nothing is p0, because which words are never-words and which are the author's is what a corpus decides. Build private/corpus_rates.json with --rebuild-baseline, read the counts, then promote the words at 0 to 2 per 100k words to class ban / group t1, mark the ones you use as group t2, add your own moves from build_profile.py as class move, and set p0 on the habits a rejected draft of your own work ran high on.",
 "patterns": [
  {"id": "dash", "label": "em-dash / en-dash as punctuation", "class": "ban", "group": "dash", "regex": "—|(?<![0-9])–(?![0-9])", "fix": "commas, parentheses, or two sentences"},

  {"id": "additionally", "label": "Additionally", "class": "watch", "regex": "\\badditionally\\b"},
  {"id": "akin-to", "label": "akin to", "class": "watch", "regex": "\\bakin to\\b"},
  {"id": "albeit", "label": "albeit", "class": "watch", "regex": "\\balbeit\\b"},
  {"id": "at-once", "label": "'at once'", "class": "watch", "regex": "\\bat once\\b", "fix": "at the same time / immediately"},
  {"id": "boasts", "label": "boasts", "class": "watch", "regex": "\\bboast(?:s|ed|ing)?\\b"},
  {"id": "bolster", "label": "bolster", "class": "watch", "regex": "\\bbolster(?:s|ed|ing)?\\b"},
  {"id": "comprehensive", "label": "comprehensive", "class": "watch", "regex": "\\bcomprehensive(?:ly|ness)?\\b"},
  {"id": "crucial", "label": "crucial", "class": "watch", "regex": "\\bcrucial(?:ly)?\\b", "fix": "important / key"},
  {"id": "cutting-edge", "label": "cutting-edge", "class": "watch", "regex": "\\bcutting-edge\\b"},
  {"id": "delve", "label": "delve", "class": "watch", "regex": "\\bdelv(?:e|es|ed|ing)\\b", "fix": "explore / investigate / examine"},
  {"id": "effortless", "label": "effortless", "class": "watch", "regex": "\\beffortless(?:ly)?\\b"},
  {"id": "emerge", "label": "emerge(d)", "class": "watch", "regex": "\\bemerg(?:e|es|ed|ing)\\b"},
  {"id": "empower", "label": "empower", "class": "watch", "regex": "\\bempower(?:s|ed|ing|ment)?\\b", "fix": "support / help / allow"},
  {"id": "enduring", "label": "enduring", "class": "watch", "regex": "\\benduring\\b"},
  {"id": "foster", "label": "foster", "class": "watch", "regex": "\\bfoster(?:s|ed|ing)?\\b"},
  {"id": "furthermore", "label": "Furthermore", "class": "watch", "regex": "\\bfurthermore\\b"},
  {"id": "garner", "label": "garner", "class": "watch", "regex": "\\bgarner(?:s|ed|ing)?\\b"},
  {"id": "groundbreaking", "label": "groundbreaking", "class": "watch", "regex": "\\bground-?breaking\\b"},
  {"id": "harness", "label": "harness", "class": "watch", "regex": "\\bharness(?:es|ed|ing)?\\b", "fix": "use / build on"},
  {"id": "holistic", "label": "holistic", "class": "watch", "regex": "\\bholistic(?:ally)?\\b"},
  {"id": "importantly", "label": "importantly", "class": "watch", "regex": "\\bimportantly\\b"},
  {"id": "in-kind", "label": "'in kind'", "class": "watch", "regex": "\\bin kind\\b"},
  {"id": "interestingly", "label": "Interestingly", "class": "watch", "regex": "\\binterestingly\\b"},
  {"id": "interplay", "label": "interplay", "class": "watch", "regex": "\\binterplay\\b"},
  {"id": "intricate", "label": "intricate / intricacies", "class": "watch", "regex": "\\bintrica(?:te|cies|cy)\\b"},
  {"id": "journey", "label": "journey", "class": "watch", "regex": "\\bjourneys?\\b"},
  {"id": "lands", "label": "lands / landed (metaphorical)", "class": "watch", "regex": "\\bland(?:s|ed)\\b"},
  {"id": "landscape", "label": "landscape (metaphorical)", "class": "watch", "regex": "\\blandscapes?\\b", "fix": "prior work, or the specific literature, named"},
  {"id": "leverage", "label": "leverage", "class": "watch", "regex": "\\bleverag(?:e|es|ed|ing)\\b", "fix": "use / build on"},
  {"id": "meticulous", "label": "meticulous", "class": "watch", "regex": "\\bmeticulous(?:ly)?\\b"},
  {"id": "moreover", "label": "Moreover", "class": "watch", "regex": "\\bmoreover\\b"},
  {"id": "multifaceted", "label": "multifaceted", "class": "watch", "regex": "\\bmulti-?faceted\\b"},
  {"id": "myriad", "label": "myriad", "class": "watch", "regex": "\\bmyriad\\b"},
  {"id": "novel", "label": "novel", "class": "watch", "regex": "\\bnovel\\b", "fix": "for the actual contribution only"},
  {"id": "nuanced", "label": "nuanced", "class": "watch", "regex": "\\bnuanced?\\b"},
  {"id": "outright", "label": "'outright'", "class": "watch", "regex": "\\boutright\\b", "fix": "entirely"},
  {"id": "paradigm-shift", "label": "paradigm shift", "class": "watch", "regex": "\\bparadigm shifts?\\b"},
  {"id": "pivotal", "label": "pivotal", "class": "watch", "regex": "\\bpivotal\\b", "fix": "important / key / central"},
  {"id": "plethora", "label": "plethora", "class": "watch", "regex": "\\bplethora\\b"},
  {"id": "profound", "label": "profound", "class": "watch", "regex": "\\bprofound(?:ly)?\\b"},
  {"id": "realm", "label": "realm", "class": "watch", "regex": "\\brealms?\\b"},
  {"id": "rests-on", "label": "'rests on' (metaphorical)", "class": "watch", "regex": "\\brest(?:s|ed)? on\\b"},
  {"id": "robust", "label": "robust", "class": "watch", "regex": "\\brobust(?:ly|ness)?\\b", "fix": "as a technical term only"},
  {"id": "seamless", "label": "seamless(ly)", "class": "watch", "regex": "\\bseamless(?:ly)?\\b"},
  {"id": "settled", "label": "'settled' (metaphorical)", "class": "watch", "regex": "\\bsettled\\b"},
  {"id": "showcase", "label": "showcase", "class": "watch", "regex": "\\bshowcas(?:e|es|ed|ing)\\b"},
  {"id": "state-of-the-art", "label": "state-of-the-art", "class": "watch", "regex": "\\bstate-of-the-art\\b"},
  {"id": "synergy", "label": "synergy", "class": "watch", "regex": "\\bsynerg(?:y|ies|istic)\\b"},
  {"id": "tapestry", "label": "tapestry", "class": "watch", "regex": "\\btapestr(?:y|ies)\\b"},
  {"id": "testament", "label": "testament", "class": "watch", "regex": "\\btestament\\b"},
  {"id": "transformative", "label": "transformative", "class": "watch", "regex": "\\btransformative\\b"},
  {"id": "underscore", "label": "underscore(s)", "class": "watch", "regex": "\\bunderscor(?:e|es|ed|ing)\\b"},
  {"id": "unlock", "label": "unlock", "class": "watch", "regex": "\\bunlock(?:s|ed|ing)?\\b"},
  {"id": "utilize", "label": "utilize", "class": "watch", "regex": "\\butili[sz](?:e|es|ed|ing|ation)\\b", "fix": "use"},
  {"id": "versatile", "label": "versatile", "class": "watch", "regex": "\\bversatil(?:e|ity)\\b"},
  {"id": "vibrant", "label": "vibrant", "class": "watch", "regex": "\\bvibrant\\b"},
  {"id": "vital", "label": "vital", "class": "watch", "regex": "\\bvital(?:ly)?\\b"},

  {"id": "it-is-important", "label": "'it is important / worth noting that'", "class": "watch", "group": "t3", "regex": "\\bit is (?:important|worth noting|worth mentioning)\\b", "fix": "cut it"},
  {"id": "notably", "label": "'Notably'", "class": "watch", "group": "t3", "regex": "\\bnotably\\b"},
  {"id": "in-todays", "label": "'In today's / in the era of / with the rise of'", "class": "watch", "group": "t3", "regex": "\\bin today's\\b|\\bin the era of\\b|\\bwith the rise of\\b"},
  {"id": "not-only", "label": "'not only … (but also)'", "class": "watch", "group": "t3", "regex": "\\bnot only\\b"},
  {"id": "serves-as", "label": "'serves as / acts as'", "class": "watch", "group": "t3", "regex": "\\b(?:serv(?:e|es|ed|ing)|act(?:s|ed|ing)?) as\\b", "fix": "is"},
  {"id": "plays-role", "label": "'plays a … role'", "class": "watch", "group": "t3", "regex": "\\bplay(?:s|ed|ing)? (?:an?|the) (?:\\w+ )?role\\b"},
  {"id": "highlights-importance", "label": "'highlights the importance / need'", "class": "watch", "group": "t3", "regex": "\\bhighlights? the (?:importance|need|value)\\b"},
  {"id": "stands-as", "label": "'stands as / functions as / represents / marks' (importance-verbs)", "class": "watch", "group": "t3", "regex": "\\bstands? as\\b|\\bfunctions? as\\b|\\brepresents?\\b|\\bmarks\\b", "fix": "is"},
  {"id": "amplifier", "label": "'significantly enhances / greatly improves / vast potential'", "class": "watch", "group": "t3", "regex": "\\bsignificantly enhanc|\\bgreatly improv|\\bvast potential\\b"},
  {"id": "filler-adverb", "label": "'in other words / namely / indeed / ultimately / essentially'", "class": "watch", "group": "t3", "regex": "\\bin other words\\b|\\bnamely\\b|\\bindeed\\b|\\bultimately\\b|\\bessentially\\b"},
  {"id": "praise-adj", "label": "'fundamental / meaningful / powerful / compelling / actionable'", "class": "watch", "group": "t3", "regex": "\\bfundamental(?:ly)?\\b|\\bmeaningful(?:ly)?\\b|\\bpowerful\\b|\\bcompelling\\b|\\bactionable\\b"},

  {"id": "every", "label": "'every' as an intensifier", "class": "watch", "regex": "\\bevery\\b", "fix": "each, all, or drop the word"},
  {"id": "colon-clause", "label": "clause-joining colon (heuristic: a full clause follows)", "class": "watch", "matcher": "colon_clause", "fix": "a period, or since / because / where / in which / so that"},
  {"id": "colon-all", "label": "mid-sentence colon, lowercase after (list, quote and clause colons)", "class": "info", "matcher": "colon_any"},
  {"id": "rather-than", "label": "'rather than'", "class": "watch", "regex": "\\brather than\\b", "fix": "instead of / and not / two sentences"},
  {"id": "both-opener", "label": "sentence-initial 'Both' / 'Neither'", "class": "watch", "regex": "(?:Both|Neither)\\b", "start": true, "fix": "name the two things"},
  {"id": "what-cleft", "label": "What-cleft opener (What … is/was …)", "class": "watch", "regex": "What\\b[^.!?]{2,80}?\\b(?:is|was|are|were)\\b", "start": true, "statement": true, "fix": "say who did what"},
  {"id": "where-here", "label": "'Where X, here Y' opener", "class": "watch", "regex": "Where\\b", "start": true, "statement": true, "fix": "While …, or two sentences"},
  {"id": "issue-not-that", "label": "'The issue is not that X, but that Y' antithesis", "class": "watch", "regex": "\\b(?:is|was) not (?:that|whether)\\b", "fix": "state the positive claim; let the contrast follow with However, or while"},
  {"id": "not-tail", "label": "contrastive tail ', not …'", "class": "watch", "regex": ", not\\b", "fix": "state the positive claim; However, / while"},
  {"id": "not-x-but-y", "label": "'not X, but Y' antithesis", "class": "watch", "regex": "\\bnot\\b[^.;:]{2,60}, but\\b", "fix": "state the positive claim; However, / while"},
  {"id": "the-x-is-opener", "label": "'The X is/was …' abstract-noun topic sentence (rough proxy)", "class": "watch", "regex": "The [a-z]+(?: [a-z]+)? (?:was|were|is|are) ", "start": true, "fix": "start from the participants or from 'we'"},
  {"id": "semicolon", "label": "semicolon", "class": "watch", "regex": ";", "fix": "two sentences, or a conjunction"},

  {"id": "for-example-opener", "label": "sentence-initial 'For example' (placeholder: replace with your own top openers from build_profile.py)", "class": "move", "group": "move", "regex": "For example", "start": true},
  {"id": "we-found", "label": "'we found' (placeholder: replace with your own recurring frames)", "class": "move", "group": "move", "regex": "\\bwe found\\b"}
 ]
}
